# =============================================================================
# .env.dev — Biến môi trường cho MÔI TRƯỜNG PHÁT TRIỂN
# =============================================================================
# KHÔNG phải file cấu hình của prod. Prod dùng /opt/kpi-prod/backend/.env
#
# File này chỉ chứa các giá trị CẦN KHÁC prod. Những gì không khai báo ở đây
# vẫn lấy từ .env như cũ (khoá bí mật, cấu hình Zalo…), vì pydantic-settings
# ưu tiên biến môi trường hơn file .env.
#
# Nạp bằng: source scripts/dev.sh  (hoặc scripts/dev.sh chay)
# =============================================================================

# ── Cơ sở dữ liệu ────────────────────────────────────────────────────────
# Bản sao của prod, làm mới bằng: scripts/dev.sh lam-moi-db
DB_NAME=kpi_haiquan_test

# ── Thư mục file ─────────────────────────────────────────────────────────
# Dev có kho file RIÊNG. Nếu để trùng prod thì thử nghiệm upload/xoá sẽ đụng
# vào tài liệu thật của người dùng.
HKG_UPLOAD_DIR=/root/kpi-haiquan/backend/uploads-dev/meeting

# ── Cổng: prod 8000–8007 + 3000 · dev 9000–9007 + 3001 ──────────────────
# Chạy song song được, không tranh cổng.
DEV_PORT_KPI=9000
DEV_PORT_LMS=9001
DEV_PORT_FORUM=9002
DEV_PORT_LEGAL=9003
DEV_PORT_PORTAL=9004
DEV_PORT_COMMON=9005
DEV_PORT_MEETING=9006
DEV_PORT_CHITIEU=9007
DEV_PORT_FRONTEND=3001

# ── Tắt các tác vụ nền không nên chạy ở dev ─────────────────────────────
# Scheduler dev sẽ gửi nhắc họp trùng với prod nếu để bật.
HKG_DISABLE_SCHEDULER=true
# Worker Zalo dev sẽ gửi tin nhắn THẬT tới người dùng nếu để bật.
ZALO_DRY_RUN=true

# Khoá cho chatbot Zalo gọi endpoint /dgnl/cong-khai/* (chỉ dùng ở DEV)
ZALO_BOT_API_KEY=67115f5ad26fe0c78f5911023b89ad5e8161c00eab0b91572b9c79daa6541299

# Soi header/query Zalo gửi tới endpoint công khai (chỉ dev)
DGNL_SOI_YEU_CAU=true
