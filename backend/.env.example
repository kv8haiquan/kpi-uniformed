# =============================================================================
# ENVIRONMENT VARIABLES - Hải quan KV8 Backend
# Copy file này thành .env và điền giá trị thực
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME="Hải quan KV8 - KPI System"
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# DATABASE - PostgreSQL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=haiquan_kv8
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Async connection string (được build tự động từ các biến trên)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/db

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Tạo bằng: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_change_in_production_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 tiếng

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json              # json | text

# -----------------------------------------------------------------------------
# REDIS (cho caching & session - optional)
# -----------------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# FILE PATHS
# -----------------------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./uploads

# =============================================================================
# PLATFORM MỞ RỘNG — Dùng cho các service mới (LMS, Forum, Legal, Portal)
# =============================================================================

# Database URL (async) — cùng database với KPI, mỗi module dùng schema riêng
# DATABASE_URL=postgresql+asyncpg://kpi_user:password@localhost:5433/kpi_haiquan

# Secret key — PHẢI giống SECRET_KEY của KPI backend để decode JWT
# SECRET_KEY=your-secret-key-must-match-kpi-backend
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (cache/queue)
# REDIS_URL=redis://localhost:6379/0

# MinIO (file storage)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=kv08-files

# Internal API key cho giao tiep noi bo giua cac service
INTERNAL_API_KEY=your_internal_api_key_here
