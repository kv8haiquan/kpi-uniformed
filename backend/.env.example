# =============================================================================
# ENVIRONMENT VARIABLES - Hải quan KV8 Backend
# Copy file này thành .env và điền giá trị thực
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME="Hải quan KV8 - KPI System"
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# DATABASE - PostgreSQL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=haiquan_kv8
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Async connection string (được build tự động từ các biến trên)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/db

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Tạo bằng: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_change_in_production_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 tiếng

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json              # json | text

# -----------------------------------------------------------------------------
# REDIS (cho caching & session - optional)
# -----------------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# FILE PATHS
# -----------------------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./uploads

# =============================================================================
# PLATFORM MỞ RỘNG — Dùng cho các service mới (LMS, Forum, Legal, Portal)
# =============================================================================

# Database URL (async) — cùng database với KPI, mỗi module dùng schema riêng
# DATABASE_URL=postgresql+asyncpg://kpi_user:password@localhost:5433/kpi_haiquan

# Secret key — PHẢI giống SECRET_KEY của KPI backend để decode JWT
# SECRET_KEY=your-secret-key-must-match-kpi-backend
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (cache/queue)
# REDIS_URL=redis://localhost:6379/0

# MinIO (file storage)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=kv08-files

# Internal API key cho giao tiep noi bo giua cac service
INTERNAL_API_KEY=your_internal_api_key_here

# ═══════════════════════════════════════════════════════════════════════
# ZALO OA — kênh đẩy thông báo (common_service/services/zalo/)
# ═══════════════════════════════════════════════════════════════════════
# HAI CỜ AN TOÀN — cả hai đều mặc định KHÔNG gửi tin thật.
# Muốn gửi thật phải chủ động đặt CẢ HAI. Bật ZALO_ENABLED mà quên tắt
# ZALO_DRY_RUN thì worker vẫn chạy nhưng chỉ ghi log — an toàn để chạy thử.
ZALO_ENABLED=false
ZALO_DRY_RUN=true

# Credential từ Zalo Developers — KHÔNG commit giá trị thật vào git
ZALO_APP_ID=
# ZALO_OA_ID chỉ để ghi lại OA đang dùng, KHÔNG cần cho lời gọi API — để trống vẫn chạy
ZALO_OA_ID=
ZALO_OA_SECRET=

# Template ID do Zalo cấp sau khi duyệt (4 template cho HKG).
# Để trống = chưa duyệt xong → worker đánh dấu BO_QUA thay vì gửi lỗi.
ZALO_TPL_MOI_HOP=
ZALO_TPL_NHAC_HOP=
ZALO_TPL_THAY_DOI_HOP=
ZALO_TPL_HUY_HOP=

# Phạm vi bật — giai đoạn 1 chỉ HKG. Thêm KPI/LMS: "MEETING,KPI,LMS"
ZALO_LOAI_BAT=MEETING

# Vận hành
ZALO_CHU_KY_GIAY=60
ZALO_CUA_SO_QUET_PHUT=120
ZALO_SO_LAN_THU_TOI_DA=4
ZALO_MOI_LAN_GUI=50
# Khung giờ yên tĩnh (giờ VN) — không nhắn ngoài khoảng này
ZALO_KHONG_GUI_TRUOC_GIO=6
ZALO_KHONG_GUI_SAU_GIO=22
